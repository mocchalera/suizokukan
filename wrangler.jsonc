{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suizokukan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "umi.mocchalera.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "SeaRoom" },
      { "name": "BUDGET", "class_name": "DailyBudget" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SeaRoom", "DailyBudget"] }],
  "vars": { "JEV_DAILY_LIMIT": "1000", "JEV_MODEL": "jev-1.13.0" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": false }
}
